#!/bin/bash
#
# Static analysis gate for the plugin and the extension library.
#
#   static-analysis [-c name=compiler]... [-u]
#
# Runs, over src/*.c and lib/src/*.c:
#
#   gcc -fanalyzer    use after free, double free, leaks, NULL
#                     dereference, uninitialised reads; at -O0 and -O2
#   clang --analyze   the same from a second engine, with the alpha
#                     core/unix/security checkers
#   clang-tidy        bugprone-*, cert-*, clang-analyzer-*, misc-*
#   cppcheck          everything, exhaustive, inconclusive included
#   flawfinder        race-prone calls (TOCTOU), unsafe string and
#                     buffer functions
#   sparse            type confusion
#
# and compiles every file with each -c compiler (e.g.
# -c armv7-gcc="arm-linux-gnueabihf-gcc --sysroot=..." -c
# x86_64-clang="clang --target=x86_64-linux-gnu --sysroot=...") with
# a strict warning set. Build all supported targets with both GCC and
# Clang: armv7 is 32-bit and finds what the 64-bit ones don't.
#
# Findings are compared, without line numbers, against
# static-analysis.baseline: the findings that were triaged as false
# positives or accepted, each with the reason. Anything not in there
# fails the run. -u rewrites the baseline from this run (review the
# diff and give every new entry a reason before committing it).
#
# Dependencies are found with pkg-config, as the build does; set
# PKG_CONFIG_SYSROOT_DIR/PKG_CONFIG_LIBDIR for a sysroot, and
# ANALYZE_FLAGS for whatever else the analyzers need to parse the code
# for that target (e.g. "--target=x86_64-linux-gnu --sysroot=...").
# GCC_ANALYZER is the gcc used for -fanalyzer (default: gcc). A tool
# that isn't installed is reported as skipped, not passed.
#

set -u

TOP_DIR=$(cd "$(dirname "$0")/../.." && pwd)
HERE="$TOP_DIR/unit/hardening"
BASELINE="$HERE/static-analysis.baseline"
LOG_DIR="$HERE/logs"
GCC_ANALYZER=${GCC_ANALYZER:-gcc}
ANALYZE_FLAGS=${ANALYZE_FLAGS:-}
UPDATE=0
COMPILERS=()

while [ $# -gt 0 ]; do
    case "$1" in
    -c) COMPILERS+=("$2"); shift 2;;
    -u) UPDATE=1; shift;;
    *) echo "Usage: $0 [-c name=compiler]... [-u]" >&2; exit 2;;
    esac
done

PKGS="ofono dbus-1 libgbinder-radio libgbinder libmce-glib libglibutil gobject-2.0 glib-2.0"

# pkg-config flags, for the sysroot a compiler command names if it does
pkg_cflags() {
    local sr
    sr=$(echo "$1" | sed -nE 's/.*--sysroot=([^ ]+).*/\1/p')
    if [ -n "$sr" ]; then
        PKG_CONFIG_SYSROOT_DIR="$sr" \
        PKG_CONFIG_LIBDIR="$sr/usr/lib/pkgconfig:$sr/usr/share/pkgconfig" \
            pkg-config --cflags $PKGS
    else
        pkg-config --cflags $PKGS
    fi
}

PKG_CFLAGS=$(pkg_cflags "$ANALYZE_FLAGS $GCC_ANALYZER") || {
    echo "pkg-config can't find: $PKGS" >&2; exit 2; }
DEFINES="-DGLIB_VERSION_MAX_ALLOWED=GLIB_VERSION_2_32 -DGLIB_VERSION_MIN_REQUIRED=GLIB_VERSION_MAX_ALLOWED"
INCLUDES="-Isrc -Ilib/include $PKG_CFLAGS"
WARNINGS="-Wall -Wextra -Wshadow -Wformat=2 -Wcast-align -Wpointer-arith \
-Wvla -Wno-unused-parameter -Wno-missing-field-initializers -Wno-sign-compare"
# Upstream marks its TODOs with #pragma message, which Clang reports
CLANG_WARNINGS="-Wno-#pragma-messages"

# Idioms of this code base that these checks flag everywhere:
#   misc-unused-parameters                 callback signatures
#   bugprone-casting-through-void          GObject/GLib casts
#   bugprone-reserved-identifier, cert-dcl37-c, cert-dcl51-cpp
#                                          G_ and _ prefixed macros
#   bugprone-easily-swappable-parameters   style
#   bugprone-assignment-in-if-condition    style
#   bugprone-multi-level-implicit-pointer-conversion   GLib APIs
#   misc-include-cleaner                   not about correctness
#   clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling
#                                          memcpy/snprintf (C11 Annex K)
TIDY_CHECKS="-*,bugprone-*,cert-*,clang-analyzer-*,misc-*,\
-misc-unused-parameters,-bugprone-casting-through-void,\
-bugprone-reserved-identifier,-cert-dcl37-c,-cert-dcl51-cpp,\
-bugprone-easily-swappable-parameters,-bugprone-assignment-in-if-condition,\
-bugprone-multi-level-implicit-pointer-conversion,-misc-include-cleaner,\
-clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling"

cd "$TOP_DIR" || exit 2
FILES=$(ls src/*.c lib/src/*.c)
mkdir -p "$LOG_DIR"
FOUND="$LOG_DIR/findings"
: > "$FOUND"
skipped=()

have() {
    command -v "$1" >/dev/null 2>&1 && return 0
    echo "== $2: $1 not installed, skipped"
    skipped+=("$2")
    return 1
}

# tool < compiler style output: keep "file:line:col: warning|error: ..."
# lines for our own files, drop the position
collect() {
    sed -nE "s#^($TOP_DIR/)?((src|lib)/[^:]+):[0-9]+:[0-9]+: (warning|error): #$1: \2: #p" |
        sort -u >> "$FOUND"
}

for c in "${COMPILERS[@]}"; do
    name=${c%%=*}; cc=${c#*=}
    echo "== $name"
    case "$cc" in *clang*) cc_warnings=$CLANG_WARNINGS;; *) cc_warnings=;; esac
    cc_includes="-Isrc -Ilib/include $(pkg_cflags "$cc")" || {
        echo "pkg-config failed for $name" >&2; exit 2; }
    for f in $FILES; do
        # shellcheck disable=SC2086
        $cc -std=gnu11 -O2 -fPIC $WARNINGS $cc_warnings $DEFINES $cc_includes -S "$f" \
            -o /dev/null 2>&1 || echo "src/BUILD:0:0: error: $f failed to build"
    done > "$LOG_DIR/$name.log"
    collect "$name" < "$LOG_DIR/$name.log"
done

if have "${GCC_ANALYZER%% *}" "gcc -fanalyzer"; then
    for o in O0 O2; do
        echo "== gcc -fanalyzer -$o"
        for f in $FILES; do
            # shellcheck disable=SC2086
            $GCC_ANALYZER -std=gnu11 -$o -fanalyzer -fPIC $DEFINES $INCLUDES \
                -S "$f" -o /dev/null 2>&1
        done | grep -E "\[-Wanalyzer" > "$LOG_DIR/fanalyzer-$o.log"
        collect "fanalyzer" < "$LOG_DIR/fanalyzer-$o.log"
    done
fi

if have clang "clang --analyze"; then
    echo "== clang --analyze"
    for f in $FILES; do
        # shellcheck disable=SC2086
        # The memcpy/snprintf (Annex K) and GObject struct cast checkers
        # are off: clang-tidy reports the former, the latter is every cast
        clang $ANALYZE_FLAGS --analyze -Xanalyzer -analyzer-checker=\
core,unix,security,deadcode,nullability,alpha.core,alpha.unix,alpha.security \
            -Xanalyzer -analyzer-disable-checker=\
security.insecureAPI.DeprecatedOrUnsafeBufferHandling,alpha.core.CastToStruct \
            -std=gnu11 $DEFINES $INCLUDES "$f" -o /dev/null 2>&1
    done > "$LOG_DIR/clang-analyze.log"
    collect "clang-analyze" < "$LOG_DIR/clang-analyze.log"
fi

if have clang-tidy clang-tidy; then
    echo "== clang-tidy"
    # shellcheck disable=SC2086
    clang-tidy -quiet --checks="$TIDY_CHECKS" $FILES -- $ANALYZE_FLAGS \
        -std=gnu11 $DEFINES $INCLUDES > "$LOG_DIR/clang-tidy.log" 2>&1
    collect "clang-tidy" < "$LOG_DIR/clang-tidy.log"
fi

# Style only advice is suppressed: const correctness of pointers and
# callback parameters, argument names in prototypes, static/scope hints
if have cppcheck cppcheck; then
    echo "== cppcheck"
    # Our own dependencies only, cppcheck's gtk library covers GLib
    CPPCHECK_INCLUDES=$(echo "$PKG_CFLAGS" | tr ' ' '\n' | grep '^-I' |
        grep -E 'gbinder|gutil|ofono' | tr '\n' ' ')
    # shellcheck disable=SC2086
    cppcheck -q --enable=all --check-level=exhaustive --inconclusive \
        --std=c11 --library=gtk --suppress=missingIncludeSystem \
        --suppress=unusedFunction --suppress=checkersReport \
        --suppress=funcArgNamesDifferent --suppress=constParameterCallback \
        --suppress=constParameterPointer --suppress=constVariablePointer \
        --suppress=staticFunction --suppress=variableScope \
        --template='{file}:{line}:{column}: warning: {message} [{id}]' \
        -Isrc -Ilib/include $CPPCHECK_INCLUDES \
        -D__GNUC__ $FILES > "$LOG_DIR/cppcheck.log" 2>&1
    collect "cppcheck" < "$LOG_DIR/cppcheck.log"
fi

if have flawfinder flawfinder; then
    echo "== flawfinder"
    flawfinder --minlevel=1 --singleline --quiet --dataonly $FILES \
        > "$LOG_DIR/flawfinder.log" 2>&1
    sed -nE 's#^((src|lib)/[^:]+):[0-9]+:([0-9]+:)?  *(\[[0-9]\] \([a-z]+\) [A-Za-z_0-9]+).*#flawfinder: \1: \4#p' \
        "$LOG_DIR/flawfinder.log" | sort -u >> "$FOUND"
fi

if have sparse sparse; then
    echo "== sparse"
    for f in $FILES; do
        # shellcheck disable=SC2086
        sparse -std=gnu11 -Wno-decl $ANALYZE_FLAGS $DEFINES $INCLUDES "$f" 2>&1
    done > "$LOG_DIR/sparse.log"
    collect "sparse" < "$LOG_DIR/sparse.log"
fi

sort -u -o "$FOUND" "$FOUND"
if [ $UPDATE = 1 ]; then
    # Keep the reasons of the entries that are still there
    { grep -E '^#' "$BASELINE" 2>/dev/null
      while IFS= read -r line; do
          reason=$(grep -F -x -A1 -- "$line" "$BASELINE" 2>/dev/null |
              grep -E '^  why:' | tail -n 1)
          echo "$line"
          echo "${reason:-  why: TODO}"
      done < "$FOUND"; } > "$BASELINE.new"
    mv "$BASELINE.new" "$BASELINE"
    echo "Baseline updated: $(wc -l < "$FOUND") findings"
    exit 0
fi

grep -vE '^(#|  why:|$)' "$BASELINE" 2>/dev/null | sort -u > "$LOG_DIR/baseline"
new=$(comm -23 "$FOUND" "$LOG_DIR/baseline")
gone=$(comm -13 "$FOUND" "$LOG_DIR/baseline")
if [ -n "$gone" ]; then
    echo "Baseline entries no longer found (remove them):"
    echo "$gone" | sed 's/^/  /'
fi
[ ${#skipped[@]} -eq 0 ] || echo "Skipped: ${skipped[*]}"
if [ -n "$new" ]; then
    echo "*** New findings:"
    echo "$new" | sed 's/^/  /'
    exit 1
fi
echo "No new findings ($(wc -l < "$FOUND") in the baseline)"
